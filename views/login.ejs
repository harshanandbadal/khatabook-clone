<!DOCTYPE html>
<html>
<head>
    <title>Khatabook Clone - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 h-screen flex items-center justify-center">
    <div class="bg-white p-8 rounded shadow-md w-96">
        <h1 class="text-2xl font-bold mb-6 text-center text-blue-600">Digital Ledger</h1>
        <% if(error) { %> <p class="text-red-500 mb-4 text-center"><%= error %></p> <% } %>
        
        <form action="/login" method="POST" class="mb-4">
            <h2 class="text-lg mb-2">Login</h2>
            <input type="text" name="username" placeholder="Username" required class="w-full border p-2 rounded mb-2">
            <input type="password" name="password" placeholder="Password" required class="w-full border p-2 rounded mb-2">
            <button type="submit" class="w-full bg-blue-500 text-white p-2 rounded">Login</button>
        </form>

        <hr class="my-4">

        <form action="/register" method="POST">
            <h2 class="text-lg mb-2">Create Account</h2>
            <input type="text" name="username" placeholder="New Username" required class="w-full border p-2 rounded mb-2">
            <input type="password" name="password" placeholder="New Password" required class="w-full border p-2 rounded mb-2">
            <button type="submit" class="w-full bg-green-500 text-white p-2 rounded">Register</button>
        </form>
    </div>
</body>
</html>