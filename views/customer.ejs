<!DOCTYPE html>
<html>
<head>
    <title><%= customer.name %> - Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Hide everything except the invoice during printing */
        @media print {
            body * { visibility: hidden; }
            #printable-invoice, #printable-invoice * { visibility: visible; }
            #printable-invoice { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-3xl mx-auto bg-white p-6 rounded shadow-md" id="printable-invoice">
        
        <div class="flex justify-between items-center mb-6">
            <div>
                <a href="/" class="text-blue-500 no-print mb-2 inline-block">⬅ Back</a>
                <h1 class="text-2xl font-bold"><%= customer.name %></h1>
                <p class="text-gray-500">Phone: <%= customer.phone %></p>
            </div>
            <div class="text-right">
                <h2 class="text-lg">Net Balance</h2>
                <!-- If balance is negative, user is owed money (red). If positive, user owes money (green). -->
                <p class="text-2xl font-bold <%= balance < 0 ? 'text-red-500' : 'text-green-500' %>">
                    ₹ <%= Math.abs(balance) %> 
                    <span class="text-sm font-normal"><%= balance < 0 ? '(You will get)' : (balance > 0 ? '(You will give)' : 'Settled') %></span>
                </p>
            </div>
        </div>

        <div class="flex gap-4 mb-6 no-print">
            <button onclick="window.print()" class="bg-gray-800 text-white p-2 rounded px-4 w-full">🖨 Print Invoice</button>
        </div>

        <form action="/add-transaction/<%= customer.id %>" method="POST" class="bg-gray-50 p-4 rounded mb-6 flex gap-2 no-print border">
            <input type="number" name="amount" placeholder="Amount (₹)" required class="border p-2 rounded flex-1">
            <input type="text" name="description" placeholder="Item / Description" required class="border p-2 rounded flex-1">
            <select name="type" class="border p-2 rounded">
                <option value="give">You Gave (Red)</option>
                <option value="got">You Got (Green)</option>
            </select>
            <button type="submit" class="bg-blue-500 text-white p-2 rounded px-4">Add Entry</button>
        </form>

        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b bg-gray-50">
                    <th class="p-2">Date</th>
                    <th class="p-2">Description</th>
                    <th class="p-2 text-red-500">You Gave</th>
                    <th class="p-2 text-green-500">You Got</th>
                </tr>
            </thead>
            <tbody>
                <% transactions.forEach(function(t) { %>
                    <tr class="border-b">
                        <td class="p-2 text-sm text-gray-600"><%= new Date(t.date).toLocaleString() %></td>
                        <td class="p-2"><%= t.description %></td>
                        <td class="p-2 text-red-500 font-bold"><%= t.type === 'give' ? '₹ ' + t.amount : '-' %></td>
                        <td class="p-2 text-green-500 font-bold"><%= t.type === 'got' ? '₹ ' + t.amount : '-' %></td>
                    </tr>
                <% }); %>
                <% if(transactions.length === 0) { %>
                    <tr><td colspan="4" class="p-4 text-center text-gray-500">No transactions recorded yet.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>